# 이 파일을 복사해 이름을 .env 로 바꾼 뒤, = 뒤에 값을 채우세요.
# .env.example 은 '어떤 칸이 필요한지' 알려주는 안내서라 git 에 올려요. 진짜 값은 .env 에만 써요.

# 세션·flash 쿠키에 도장(서명)을 찍는 비밀 열쇠예요. 남에게 알려지면 쿠키를 위조할 수 있어요.
# 길고 무작위인 글자를 넣으세요. 만드는 법: python -c "import secrets; print(secrets.token_hex(32))"
# 서버(배포)용은 내 컴퓨터와 다른 값을 쓰세요. 값이 바뀌면 이전 찜 목록은 사라져요.
SECRET_KEY=

# 내 컴퓨터에서만 1 로 두세요 (코드를 고치면 자동으로 다시 켜지고, 에러를 자세히 보여줘요).
# 서버에서는 비워 두거나 0. 켜 두면 에러 화면으로 코드가 노출될 수 있어요.
FLASK_DEBUG=
